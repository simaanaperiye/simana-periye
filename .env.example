# Copy this to .env and fill in your values

# PostgreSQL (Vercel Postgres / Neon)
DATABASE_URL="postgres://..."
DIRECT_URL="postgres://..."

# Admin auth — generate a random 32+ char string
SESSION_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Stripe — from dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Your deployed URL (update after Vercel deployment)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
